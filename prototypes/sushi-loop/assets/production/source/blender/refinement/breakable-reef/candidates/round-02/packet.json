{
  "schemaVersion": 1,
  "asset": "breakable-reef",
  "style": "Warm, softly lit cartoon 3D matching the approved underwater production pieces (see inputs/warm-soft-reference.png for finish only): pale warm limestone/coral-rock with hairline cracks, small pores, chipped corners and banded tan sides, as in the frozen target. Readable at phone size; clearly paler and warmer than the blue bedrock so it reads as breakable. Real 3D render output from an editable Blender source; no paint-over.",
  "qualityCriteria": {
    "frozenFrom": "reviews/criteria.json",
    "criteriaSHA256": "5f6410ce5d8e6c7e11eca0905abd66c74712cd0edc4581b2df7fcc7c76d7a59c",
    "frozenBy": "coordinator",
    "frozenAt": "2026-11-13",
    "shapeVolume": "Approved slab layout, height and locked outline unchanged; small chipped top corners within 0.03 cell; no chips into fronts or rounded corners.",
    "color": "Peach-cream tops over a clearly deeper warm tan front, darkening slightly toward the seabed, gentle per-slab variation; clearly paler and warmer than blue bedrock; no more orange than the target.",
    "lightingHighlights": "Soft warm highlight on top edges instead of a grey rim; recipe rig family; no preferred horizontal direction, no cast shadow.",
    "materialDetail": "2-4 soft horizontal bands on fronts following world height; hairline cracks on roughly a third to half of slabs; sparse pores (2x only); equal detail density on every piece.",
    "seamContinuity": "No jump in tone, light, bevel or band height across cell seams for any mask/pattern pairing; no crack or chip cut off by a straight cell edge.",
    "artifactFreeReadability": "Grooves read as narrow warm shadow lines with no blue seabed inside a cell and no dark wedges; no diagonal shading lines, black patches, speckle or downsample shimmer; clean alpha edges; rubble uses the slab palette and stays low.",
    "requiredEvidence": "All 50 native captures + published sprites with hashes; assembly.png of the same 6x6 patch; a seam stress sheet pairing different masks/patterns at native size and 2x; validation.json proving outline, registration and rubble height unchanged; one unchanged piece rendered twice to set the pixel tolerance before any numeric comparison."
  },
