{
  "schemaVersion": 1,
  "asset": "lantern-gold",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks.",
  "qualityCriteria": {
    "aestheticGoals": [
      {
        "id": "shapeVolume",
        "observableSuccess": "The cage remains compact and ribbed with its original five-band rhythm, octagonal character, caps and support silhouette. Edges read softly rounded through light and modest bevel treatment; faces have continuous readable volume without becoming inflated, melted or cylindrical.",
        "failureSignals": [
          "Lost or merged ribs",
          "Changed construction or support length",
          "Softened silhouette that grows beyond the source envelope",
          "Abrupt flat-face steps dominating the paper surface"
        ]
      },
      {
        "id": "color",
        "observableSuccess": "Paper and ribs read as warm gold/honey yellow, with small warm highlight areas and amber shadow transitions. Brown wood stays brown and remains distinguishable from the gold body. Preserve useful separation among paper, rib bands, caps and post at logical game size.",
        "failureSignals": [
          "White-clipped body that erases layers",
          "Neon lemon or orange/red palette drift",
          "Muddy brown-gold merging",
          "Uniform flat yellow"
        ]
      },
      {
        "id": "lightingHighlights",
        "observableSuccess": "Broad gentle highlights and soft face transitions give warm cartoon volume. The lantern feels internally luminous while all structural bands remain legible. Identically oriented exposed faces receive a balanced treatment as the object rotates, and the wood has enough fill to avoid dead black areas.",
        "failureSignals": [
          "Dominant lateral highlight/shadow bias",
          "Hard narrow specular stripes",
          "Blown or posterized golden faces",
          "Directional ground shadow",
          "Glow fringe outside alpha"
        ]
      },
      {
        "id": "materialDetail",
        "observableSuccess": "Paper, gold ribs and wood have distinct but restrained surface response. Wood face/bevel variation gives the base and mount depth without noisy grain or shiny plastic; ribs have soft edges but remain deliberate structural forms. Detail remains subordinate to the readable lantern shape.",
        "failureSignals": [
          "Uniform plastic gloss",
          "Busy or directional texture",
          "Near-black wood flats",
          "Over-smoothed bands that merge",
          "Uneven bright rims competing with the body"
        ]
      },
      {
        "id": "artifactFreeReadability",
        "observableSuccess": "All four facings and the entire idle loop remain clean and immediately readable at 192x384 logical scale. The hanging cage sways as an assembly while the support stays planted; caps/ribs stay joined, and the loop closes without a visible jump. Transparent edges are clean on light, gray and dark backgrounds.",
        "failureSignals": [
          "Clipping or intersection flashes",
          "Black patches, seams or broken corners",
          "Detached parts or exposed ends",
          "Z-fighting",
          "Frame-to-frame tone/alpha popping",
          "Jittering root or sliding base",
          "Texture swimming",
          "Cropped silhouette or halo"
        ]
      }
    ]
  },
