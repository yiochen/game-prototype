    "nativeContractSHA256": "76b4fbe51e7d758507727103fd337994cef4a451109f56da8e04a85d344f403c",
    "preparationManifestSHA256": "1d7de8306e9cc0f2db4bc3d3880d0830b25486f1cf21e3796ea218210e022a3c",
    "requiredEvidence": {
      "native": "For future exact candidate: all4facings\u00d712 unique idle frames48 native4x and published2x frames with original atlas layout; separate native closing frame13 per facing4. Measure source hash, camera/root/facing/frame/filter and exact adapter invocation while rendering or clean recapture. All52 phases sampled for contacts/envelope/actions/closure, with every original required phase visually covered in bound sheets/playback.",
      "visual": "Four-facing still sheet at native/logical size; all48-phase sheets/playback; separate closure comparison; logical/phone and tiny readability; light/gray/dark backgrounds;3x3 repeated arrangement and the actual submarine/eel interaction context. Native finite root/rubble and branch contact evidence, without invented modular profiles.",
      "consumer": "Bounded actual-candidate fixtures: S frame0 .570 detail and registered context; E frame6 .099 thumbnail control, native nearest sampling restored after resize and wholecanvas ordinary CSS filter. Both actual Chromium153 modes channel:'chromium' and bundled headless shell at390x844 DPR2. Broaden only if a candidate change or observed concern requires it; do not multiply all52 native phases by browser/background/viewport matrices.",
      "approval": "No preparation approval. Root freeze precedes fresh editor. Original judge later reviews exact sealed candidate and every declared packet render/preview under REVIEW-COVERAGE; final acceptance_contract.py unchanged."
    }
