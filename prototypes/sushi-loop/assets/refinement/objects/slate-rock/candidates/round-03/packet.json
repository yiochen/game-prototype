{
  "schemaVersion": 1,
  "asset": "slate-rock",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks.",
  "qualityCriteria": {
    "aestheticGoals": [
      {
        "id": "shapeVolume",
        "priority": 1,
        "success": "The irregular broad crown, sloped perimeter and substantial side depth remain readable at the logical game scale. The asymmetrical original silhouette and uneven crown remain; small soft edge responses may improve tactility without smoothing away the source facets.",
        "reject": "Round pebble silhouette, changed footprint/height, new platform, excessive inflated bevels, lost crown/side distinction, or new protruding chips."
      },
      {
        "id": "color",
        "priority": 1,
        "success": "Dominant color remains subdued slate blue-gray. Gentle neutral-to-warm gray highlight variation gives the requested welcoming cartoon feel while still reading as the source slate material.",
        "reject": "A beige/tan crown dominates, highly saturated blue, washed-out white patches, or near-black lower planes that merge into unreadable mass."
      },
      {
        "id": "lightingHighlights",
        "priority": 1,
        "success": "Broad soft diffuse light reveals crown, side facets and lower edge without crushed shadows. Highlight response is restrained and matte; rotation reveals geometry while preserving the same soft tonal family.",
        "reject": "A baked lateral spotlight, left-right directional rim, strong shiny streaks, blown crown, directional ground shadow or a dead black base band."
      },
      {
        "id": "materialDetail",
        "priority": 2,
        "success": "A restrained, stable low-frequency variation helps the broad slate facets feel tactile and softly cartoon-rendered. The fine shallow fissure remains legible and attached to the crown, with visual weight close to its original identity.",
        "reject": "Dense grain, glitter, stippled/painterly noise, arbitrary triangulation bands, deep or enlarged target-like slot, sharp white crack rim or apparent floating fissure."
      },
      {
        "id": "artifactFreeReadability",
        "priority": 1,
        "success": "All four native views are clean at native and logical size against light, gray and dark backgrounds. No clipping, z-fighting, pinholes, halos, broken corners, disconnected crack, seam bands or muddy merged planes. Repeated placements retain consistent weight and style.",
        "reject": "Any material defect or a view that only looks acceptable when enlarged; overlaid contact shadows or texture changes that do not follow the model."
      }
    ]
  },
