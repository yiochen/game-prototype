    "modelingFreedom": "Native reconstruction may improve hull/pod/window forms, proportions, structure, decoration, topology and part counts. Old blank surfaces, awkward facets and duplicated equipment are not requirements.",
    "rankedVisibleOutcomes": [
      {
        "priority": 1,
        "dimension": "shapeVolume",
        "outcome": "A substantial rounded yellow hull with convincing blue porthole depth, thick constructed trim, red side pods and readable fins/propeller/nose light. Curvature, bevels and transitions feel crafted and soft; preserve compact yellow-ship identity and functional scale. Use target as aesthetic direction, with coherent intentional rear/side design beyond its single front view."
      },
      {
        "priority": 2,
        "dimension": "materialColorLight",
        "outcome": "Warm yellow/gold shell and trim, coral/red pods, vivid blue glass and restrained dark/silver metal stay distinct at logical size in every facing. Broad clean highlights describe volume with symmetric world lighting, restrained glossy accents and no preferred horizontal illumination. Preserve useful warm contrast without clipped white-yellow plates, muddy seams or black underbody patches."
      },
      {
        "priority": 3,
        "dimension": "constructionReadability",
        "outcome": "Purposeful panel structure, pod bands, fittings and fasteners add believable construction without crowding the silhouette, glass or upgraded equipment. Details survive logical and phone presentation. No requirement to copy target rivet counts, overbright glints, halos or imagegen distortions."
      }
    ],
    "allViewDefectChecks": [
      "Native and logical light/gray/dark inspection of every required view and all576 actual candidate frames; include meaningful motion sequence and closure/inbetween review.",
      "No z-fighting, detached pieces, intersecting unintended surfaces, clipped geometry, broken normals, dead unseen-side areas, target-plane substitutes, cast-ground-shadow artifacts, alpha fringes or texture swimming.",
      "Propeller, lights, upgrade visibility and front/rear cues remain readable through their intended motions; no phase-specific per-view fitting or material adjustments."
    ],
    "functionalChecks": {
      "registration": "Exact frozen logical320\u00d7384/native640\u00d7768, root160,288 logical, sourceScale2, cell128, registered65\u00b0 camera/basis, all4 rotations and atlas6\u00d72 layout. No fit/crop/root/camera correction from alpha bounds.",
      "timing": "All12 clips\u00d712 frames\u00d712fps\u00d74directions=576. Keep static=false, impact/upgraded-impact one-shot; other10 loops with duplicate closure native key outside runtime12. Preserve bodybob/travel/impact and charge/protection/variant meanings without new mechanics.",
      "dockedRole": "Root reconciliation selected explicit docked hover: preserve wholebody/skid bob and source-like positive clearance above actual broaddeck at fixed source-facing root[-.70,-.42,.23]. supportedBy is visual depth/platform association, not grounded-skid proof. Do not invent docking struts or a ground-contact requirement.",
      "anchors": "Preserve declared attachment-base keys/3D coordinates, and report derived component muzzle/mouth geometry separately. Cable/headlight requirement names do not establish new bindings.",
      "canonicalDependency": "Freeze preliminary body/native attachment anchors/envelope, review3 separate components with fresh pairs against exactbody, adopt exact approved component geometry/materials into upgraded main, then perform final576 main capture/review."
    },
    "proposedTolerances": {
      "hardRegistrationWorld": 1e-06,
      "hardRegistrationProjectedLogicalPixels": 0.01,
      "rootNativeCameraRule": "These tolerances are numerical noise bounds, not permission for visual fitting.",
      "dockedHover": "Source measured gap .037\u2013.073 world units over broaddeckZ.22 at rootZ.23. Proposed acceptance target source-like positive gap with minimum .02 and maximum .09 in all dock moments, pending rootfreeze; do not demand exact old skid topology.",
      "designEnvelope": "Proposed improved docking envelope local x\u00b1.56,y[-.64,.68],z[.01,1.12], all phases/variants. Other clip motion may reserve x\u00b1.60. These are proposed useful caps, not source facts; root must reconcile against cover/body/components before freeze.",
      "aesthetic": "No pixel-identity/partcount/rivetcount/sphere smoothness score threshold. Differences are judged by visible outcome at use size."
    },
    "finalEvidenceMinimum": [
      "Immutable exact editable model plus all bound dependencies/action/camera/source/resource manifests.",
      "All576 native candidate frames and original-layout48 atlases; contact sheets/native/logical playback covering every exported frame with auditable paths/hashes.",
      "Independent exactsprite context all4 directions, quarter logical placement offsets0/.25/.5/.75 on light/gray/dark at native/logical/phone/landscape; body baseline/upgraded/charging/ready, repeated scale, meaningful attachment and human/equipment contexts.",
      "Physical native family assembly and independently assembled sprite context use exact immutable companions. Mixed source camera projections are disclosed rather than hidden with warps/fitting/overlap.",
      "Native hover clearance/variant envelope and actual consumer support/depth/sampling checks; approved future cover renderPass overhead must be on cover own publication, not silently claimed now."
    ],
    "preparationLimits": "576 native geometry/visibility phases,40 closures and240 meaningful half-frames audited;12 source representative renders plus one filter study rendered; all576 published source frames inspected in contact sheets. No claim that576 new source native frames were rendered or inspected at full native resolution. Final candidate coverage remains mandatory."
