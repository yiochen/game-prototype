config_version=5
[application]
config/name="Panic native2D isolated renderer harness"
run/main_scene="res://capture.tscn"
[display]
window/size/viewport_width=1080
window/size/viewport_height=760
window/size/window_width_override=1080
window/size/window_height_override=760
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.965,0.945,0.898,1)
