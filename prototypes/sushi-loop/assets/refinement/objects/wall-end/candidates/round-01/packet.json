{
  "schemaVersion": 1,
  "asset": "wall-end",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks. Follow-on design exploration: improve the modeling itself, including forms, proportions, structure, crafted details and decorations. Original part counts and awkward geometry are not constraints. The editor may rebuild native geometry to achieve the better design; the judge should reward useful improvements. Preserve the locked registration, gameplay contact/clearance, animation and modular continuity contract. See modeling-policy.json version2.",
  "qualityCriteria": {
    "asset": "wall-end",
    "status": "frozen-by-coordinator",
    "style": "warm, softly lit cartoon; original blue ceramic and honey timber palette family",
    "modelingFreedom": "Reward useful native improvements to forms, proportions, construction and purposeful crafted detail. Do not preserve weak source geometry, blank faces, original part counts or exact board count for their own sake.",
    "immutableTechnicalConstraints": [
      "Native 3D editable Blender geometry and true four rotations S=0, E=+90, N=180, W=-90; no painted target card or per-view substitutions.",
      "Exact asset camera/projection, pixel aspect, logical 192x352/frame384x704, logical root[96,256], sourceScale2 and atlas layout; no fitting, reframing, per-view recoloring or sprite warping.",
      "One-cell footprint, height1.02, ground/root/contact and functional clearance; free-end changes stay within the approved functional envelope.",
      "Only W open port at root[-0.5,0,0] with normal[-1,0,0]; exact source W plane, profile and blue/wood band levels. Free right terminal remains visibly finished.",
      "One static frame, 12fps metadata, no looping or new animation.",
      "Exact approved wall-middle family materials/capture/connection settings once supplied; shared light has no preferred horizontal direction and no directional ground cast shadow."
    ],
    "visibleCriteria": [
      {
        "id": "shape-volume",
        "priority": 1,
        "outcome": "The wall and positive-X terminal read as an intentionally finished construction. Coping, horizontal wood body and terminal have coherent depth and softened volume; cap-to-shaft, coping-to-post and base transitions look supported and resolved. Equivalent purposeful design solutions are allowed.",
        "passEvidence": "At logical size and enlarged, S/N show a clear finished end without a thin dangling bar; E/W show coherent real depth and resolved construction, not a neglected flat strip or unmodeled back. New detail does not add a second open join, expand clearance or obscure the low-wall role."
      },
      {
        "id": "palette-material-separation",
        "priority": 2,
        "outcome": "Blue ceramic is recognizably distinct from warm honey timber and the terminal belongs to the same family. Midtones stay readable through the shaft/base, and the coping does not become a flat neon rectangle or black band.",
        "passEvidence": "Material boundaries and broad form remain readable in each logical facing on light, gray and dark backgrounds, with no abrupt family color/roughness/ramp change at W."
      },
      {
        "id": "soft-light-highlights",
        "priority": 2,
        "outcome": "Broad warm illumination and controlled edge response explain volume. Highlights follow the native construction, preserve usable color and do not become glare or a continuous painted white outline. No required facing has dead black patches or a muddy unlit post base.",
        "passEvidence": "All four actual rotations use the same approved family light/material/capture settings. Front, reverse and narrow facings retain coherent shading without a preferred horizontal light direction or a ground shadow."
      },
      {
        "id": "crafted-detail",
        "priority": 2,
        "outcome": "A restrained amount of purposeful joinery, grain or construction detail strengthens the design. Wood reads as crafted timber; blue reads as solid ceramic. Details are large and quiet enough to support the main shapes.",
        "passEvidence": "At logical size, detail adds useful material/form information without noisy microtexture, dense stripes, random ornaments, accidental symbols or details that become dirty pixels. Native construction and material continuity remain plausible around visible ends and backs."
      },
      {
        "id": "intended-size-readability",
        "priority": 1,
        "outcome": "The object reads immediately as a low wall ending at one wooden post; the terminal is clearly different from a wall-middle. Main proportions, coping, timber and free-end construction survive game scale.",
        "passEvidence": "Inspect full registered 192x352 logical views without fitting, plus enlarged/native crops. E/W remain narrow because of the real camera but retain deliberate end/profile form; do not widen them by changing the capture."
      },
      {
        "id": "w-join-continuity",
        "priority": 1,
        "outcome": "The open W end connects seamlessly to the approved wall-middle: continuous shape silhouette/profile, blue/wood levels, grain/roughness/light behavior and alpha coverage. Any interior redesign resolves before the locked seam.",
        "passEvidence": "Actual native joined render and independently assembled sprite join at exact registered cell offsets, in every required rotation. Inspect RGB on light/gray/dark backgrounds and alpha at logical size and enlarged. No slit, alpha fringe, doubled ridge, mismatched top height, phase-like material jump or hidden open terminal. Bind the approved neighbor bytes/settings used."
      },
      {
        "id": "artifact-free",
        "priority": 1,
        "outcome": "Clean native geometry, surfaces and transparent edges in every facing and assembly.",
        "passEvidence": "No clipping, holes, exposed accidental ends, coplanar shimmer, black patches, overlap wedges, broken bevels, sudden normals, seams, halo, disconnected alpha specks, ground/shadow patch, blown highlight or muddy merged form. Do not copy imagegen edge artifacts."
      }
    ],
    "requiredReviewEvidence": {
      "native": [
        "Immutable hash-bound candidate packet and exact editable .blend, recipe and dependency closure.",
        "Native validation of camera/root, transform convention, footprint/height/envelope/contact, W profile coordinates/material bands and approved family settings.",
        "Four actual native RGBA captures N/E/S/W at384x704 and corresponding192x352 logical checks; no view-specific fit/color/material changes."
      ],
      "visual": [
        "All four facings inspected on light, gray and dark backgrounds at intended size and enlarged.",
        "Native W-neighbor assembly and independently assembled W-neighbor sprite previews with free terminal visible, matching approved wall-middle exact bytes.",
        "RGB and alpha seam views, logical and enlarged, for every facing; registered placement and source/render hashes documented."
      ],
      "pendingGate": "Do not issue final approval until approved exact inputs/family-settings.json is supplied and the candidate demonstrates compliance. The concept image alone is not a native family contract."
    },
    "reviewPolicy": {
      "approval": "Requires visible improvement toward the fixed target, frozen criteria and all technical evidence; no material dead spot in a required view.",
      "missingEvidence": "needs_evidence, never approval",
      "scores": "Comparative evidence only; no universal numeric pass threshold.",
      "targetInterpretation": "The single target view guides useful design and finish. It does not define unseen views, demand exact pixel imitation, permit target halos/glare or override the fixed W connection and registration."
    }
  },
