    "criteria": [
      {
        "id": "recipe-and-serving-identity",
        "priority": 1,
        "visibleSuccess": "One caramel-brown eel fillet over compact warm white rice, crossed by one continuous dark olive-green nori band, on one small ivory round ceramic serving plate. The fillet arch, rice mass, band and complete rim form a coherent appetizing serving. No garnish, chopsticks, added food, labels, scenery or ground shadow.",
        "checkAt": [
          "enlarged crop",
          "66px standalone",
          "40px bubble-food",
          "CELL32 complete registered context"
        ],
        "failureExamples": [
