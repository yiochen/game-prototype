{
  "schemaVersion": 1,
  "asset": "barrel-wood",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks.",
  "qualityCriteria": {
    "shapeVolume": [
      "Keep the existing compact bulging barrel, closed planked lid, vertical stave structure and two navy hoops recognizably intact.",
      "Use gentle edge transitions and coherent volume so lid, upper shoulder, body and hoops separate clearly at logical display size; retain useful faceting rather than requiring a smooth or photoreal surface."
    ],
    "color": [
      "Preserve the honey/golden wood and dark navy hoop palette family, with restrained warm variation between lid, shoulder and body.",
      "Avoid the source's nearly flat lemon-yellow lid and muddy, strongly darkened lower body; retain readable warmth in the lower staves without flattening form."
    ],
    "lightingHighlights": [
      "Show broad, soft transitions over the wood and modest edge highlights on the hoops; the lid must retain wood color and plank detail without clipping or glare.",
      "Hoops should read as solid navy bands with controlled volume, without requiring the target's stronger glossy accents.",
      "Use no preferred horizontal light direction and no directional ground cast shadow across the four actual native rotations."
    ],
    "materialDetail": [
      "Plank and stave divisions remain deliberate and legible, with softly defined seam depth and tidy edge contacts.",
      "Wood may carry subtle tonal variation, but fine grain, extra noise, decorative hardware and high gloss are not required.",
      "Preserve the actual native lid and stave identity rather than copying altered AI topology or adding unestablished unseen details."
    ],
    "artifactFreeReadability": [
      "At 192 x 352 logical display size, the closed lid, barrel body, wood segmentation and two navy hoops read immediately in N, E, S and W.",
      "No black gaps, muddy merged regions, coplanar flicker, exposed seams, broken corners, abrupt normal bands, clipping, stray pixels or halo fringes on light, gray and dark backgrounds.",
      "The repeated preview has coherent scale and material treatment, clear individual silhouettes and no repetitive defect that overwhelms the simple prop."
    ]
  },
