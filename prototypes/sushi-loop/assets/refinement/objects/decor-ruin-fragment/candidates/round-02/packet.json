{
  "schemaVersion": 1,
  "asset": "decor-ruin-fragment",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks. Follow-on design exploration: improve the modeling itself, including forms, proportions, structure, crafted details and decorations. Original part counts and awkward geometry are not constraints. The editor may rebuild native geometry to achieve the better design; the judge should reward useful improvements. Preserve the locked registration, gameplay contact/clearance, animation and modular continuity contract. See modeling-policy.json version2.",
  "qualityCriteria": {
    "asset": "decor-ruin-fragment",
    "version": 1,
    "status": "proposed-not-frozen",
    "judgeIndependence": "Derived from independent source/target/native/phone inspection before editor proposals.",
    "styleGoal": "Warm softly lit cartoon ruin: a substantial weathered pale carved face, cobalt reef footing and deliberate green growth. Modeling may be rebuilt to make the design richer, coherent and readable.",
    "rankedVisibleOutcomes": [
      {
        "rank": 1,
        "id": "shape-volume",
        "dimension": "shapeVolume",
        "outcome": "Read as one substantial carved stone head anchored to a broad blue reef foot. The brow, eye recesses, long nose, lower lip and ears have clear sculptural relationships; crown and edges look softly worn rather than a stack of untouched rectangular bars. Useful re-proportioning, structural rebuilding and native decoration are positive within envelope.",
        "inspect": "Front at enlarged and logical size; sides/back for believable thickness and coherent construction. No requirement for duplicate back face or old part count."
      },
      {
        "rank": 2,
        "id": "stone-growth-material",
        "dimension": "materialDetail",
        "outcome": "A few meaningful chips, fractures, stone plane changes and moss contacts communicate age and material. Growth has coherent attached lobes/rounded volumes and selected thick vegetation forms rather than neon cubes or scattered dots. Broad stone and reef facets carry the design before fine texture.",
        "inspect": "Crown, face-to-brow seams, ears, cheek/base transition and rear. Detail may be native geometry or restrained native materials; editor chooses method."
      },
      {
        "rank": 3,
        "id": "warm-readable-palette",
        "dimension": "color",
        "outcome": "Preserve pale stone, blue/cobalt reef and green growth palette family while moving to warm ivory highlights, readable pale/cool stone midtones, rich blue facets and controlled fresh greens. Stone does not become blank white; growth does not become fluorescent glare; lower blue planes retain visible form.",
        "inspect": "All four facings on neutral background and next to turquoise floor/submarine/eel. Warmth should come from useful material/light response, not an all-over yellow wash."
      },
      {
        "rank": 4,
        "id": "soft-balanced-light",
        "dimension": "lightingHighlights",
        "outcome": "Broad soft light and controlled worn-edge highlights reveal rounded stone volume. Recesses stay readable with natural local contact depth. All facings receive a coherent treatment with no preferred horizontal world light direction and no directional ground shadow.",
        "inspect": "Brow/eyes/nose, crown shoulders, underside ledges and blue base in every facing. Avoid white clipping, black creases and glossy plastic moss/stone."
      },
      {
        "rank": 5,
        "id": "phone-readability",
        "dimension": "intendedSizeReadability",
        "outcome": "At logical192x480 and the existing phone Fit review scale, the carved-face identity and three material masses remain clear. Selected weathering and growth improve silhouette/material read without turning into speckle; scenery remains subordinate to actors and warnings.",
        "inspect": "All-facing logical sheet, actual390x844 phone catalog four views, repeated3x3 and recorded submarine/eel scene using candidate images."
      },
      {
        "rank": 6,
        "id": "all-view-coherence",
        "dimension": "shapeVolume/materialDetail",
        "outcome": "Sides/back look like the same finished ruin with deliberate edge wear and sparing growth; broad calm planes are allowed. No isolated toy tabs, unexplained floating growth or one finished front concealing an unfinished rear.",
        "inspect": "All four full frames. Single-view target is a style/design guide, not an unseen-view tracing template."
      },
      {
        "rank": 7,
        "id": "defect-free",
        "dimension": "artifactFreeReadability",
        "outcome": "No material dead spots, black slabs, bright seams, coplanar flicker, normal tears, hollow exposed mesh ends, clipping, alpha fringe, disconnected floating debris or halo/speckles. Deliberate dark carved recesses and broad quiet planes are allowed when readable as intended form.",
        "inspect": "Every frame at enlarged and intended size; cream/gray/dark alpha backgrounds; ground/footing and stone/growth contacts."
      }
    ],
    "hardConstraints": {
      "assetRole": "Standalone nonblocking underwater scenery, layer2, occupiedCell[0,0], footprint1x1 centered rootCell[.5,.5]. Maintain recognizable pale stone face, green growth and blue footing.",
      "groundRoot": "Native root(0,0,0), scale1; geometry grounded atZ0; substantial full-cell undeformed footing X/Y within[-.5,.5]. Preserve actual contact with reef footing; no invented functional ports.",
      "envelope": "Overall native height may use nominal2.18. Actual source max2.09699988 and original face/crown/moss coordinates are not exact constraints. Keep complete projected silhouette<=3cells in every facing and within unchanged complete registered canvas.",
