    "aestheticSuccessCriteria": [
      {
        "id": "shapeVolume",
        "priority": 1,
        "desiredOutcome": "Read immediately as a weathered broken pale-stone column rooted on a substantial square stone foot. Pillar and base have coherent thickness and soft broad facet/bevel transitions; broken crown, fractures and moss feel integrated and purposeful. Reward improved silhouette/construction/proportions inside the functional envelope, including rebuilding source weak geometry.",
        "doNotRequire": "Exact target crack pattern, chip count, moss count, old ten parts or an exact pixel match to ImageGen."
      },
      {
        "id": "color",
        "priority": 2,
        "desiredOutcome": "Warm ivory/cream pale stone remains dominant and separates clearly from lime/olive moss. Subtle cream-gray surface variation gives crafted weathered stone without cyan cast, neon-looking luminous green, random dirty noise or a generic gray wash."
      },
      {
        "id": "lightingHighlights",
        "priority": 2,
        "desiredOutcome": "Broad soft light and gentle highlight transitions describe stone and moss volume in all four real facings. Faces retain color and readable curvature without large washed-out white patches, harsh bands, black dead spots or a preferred horizontal highlight direction."
      },
      {
        "id": "materialDetail",
        "priority": 3,
        "desiredOutcome": "Cartoon stone edges and fractures read as solid thickness with restrained chips or weathering; moss is an organic volume following crown/crevices rather than isolated bright cubes. Details remain subordinate to the large volumes and do not require microtexture, photorealism or high gloss."
      },
      {
        "id": "artifactFreeReadability",
        "priority": 1,
        "desiredOutcome": "At logical 192x320 and 128px cell scale every required facing remains a clear pale column with readable broken crown and moss masses, with clean alpha edges, sound grounding and no visible clipping, halos, pinholes, black seams, coplanar flicker, muddy merged forms, floating chips/growth or unwanted directional shadow."
      }
    ],
