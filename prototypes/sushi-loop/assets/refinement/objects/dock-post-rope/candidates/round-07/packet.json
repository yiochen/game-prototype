{
  "schemaVersion": 1,
  "asset": "dock-post-rope",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks.",
  "qualityCriteria": {
    "aestheticGoals": [
      {
        "id": "shape-volume",
        "priority": 1,
        "dimension": "shapeVolume",
        "outcome": "Wood bodies, caps, bindings and span show soft, legible local volume rather than uniform flat plates. The cream span remains a coherent sagging rope, with no separate floating beads or swollen pillow silhouette. Retain original proportions and construction contact.",
        "review": "At logical 192 x 352 size, distinguish cap top/side, body curvature, and rope top/underside without enlarging the asset; inspect all four facings enlarged for contact and normal continuity."
      },
      {
        "id": "color",
        "priority": 2,
        "dimension": "color",
        "outcome": "Retain golden/amber warm wood and cream rope. Introduce moderate warm wood value/hue variation while keeping cream visibly distinct; cap highlights retain color instead of becoming a broad flat lemon/white patch. Shadows remain warm and readable.",
        "review": "Compare baseline/target/candidate at identical registered scale; no per-facing palette shift or muddy near-face patch."
      },
      {
        "id": "light-highlights",
        "priority": 2,
        "dimension": "lightingHighlights",
        "outcome": "Use broad controlled highlights and gentle form shading to create the chosen softly lit cartoon treatment. Avoid hard highlight stripes, thin white rims, wet/plastic gloss, blown caps, or abrupt dark lower faces.",
        "review": "Inspect cap edge, rope span and bindings, both body sides, and end-on near-post plane in all facings; verify horizontal lighting symmetry from native evidence."
      },
      {
        "id": "material-detail",
        "priority": 3,
        "dimension": "materialDetail",
        "outcome": "Wood and rope remain readable through material and form at use size. Any grain or rope surface variation is broad, restrained, coherent in 3D and subordinate to silhouette. Detailed grain, exact target segment padding and gloss are optional, not approval requirements.",
        "review": "Reject texture noise, repeated dark stains, excessive contrast or tiny detail that merges into dirt. No requirement to match imagegen grain or target topology."
      },
      {
        "id": "artifact-free-readability",
        "priority": 1,
        "dimension": "artifactFreeReadability",
        "outcome": "No material dead spots, black wedges, alpha halos, coplanar flicker, seams from broken normals, rope gaps, cap/binding intersections, newly exposed ends, clipping or unwanted ground shadow. Intentional half-post outer planes are accepted.",
        "review": "Inspect exact saved N/E/S/W frames at logical size and enlarged over light/middle/dark backgrounds, plus four-view sheet and native repeated join preview."
      },
      {
        "id": "joined-continuity",
        "priority": 1,
        "dimension": "artifactFreeReadability",
        "outcome": "Same-profile adjacent modules reconstruct complete posts and bindings at the declared planes without gaps, doubled ridges, disconnected rope, or visible material discontinuity. Open outer ends of the demonstration remain available for inspection.",
        "review": "Require the catalog three-module matching-profile S placement (x=1,2,3; y=2) assembled independently from exact candidate geometry; native validation must also establish rotated port/profile consistency. Additional native join views are required if a join is occluded or ambiguous."
      }
    ]
  },
