{
  "schemaVersion": 1,
  "asset": "stool-wood",
  "style": "Refine every catalog object toward warm, softly lit cartoon art, consistent with the selected plant reference. Preserve identity, function and original palette family. Keep registered camera, dimensions, roots, sockets, ports, footprints and animation timing. No preferred horizontal light direction for rotatable world sprites; no directional ground shadows. Real 3D render output, editable Blender sources. The source 2D effects remain explicitly identified as 2D. Each object receives fresh independent editor/judge agents. Publish object-by-object to the same PR preview; integrate approved sprites into Godot after catalog review checks.",
  "qualityCriteria": {
    "shapeVolume": [
      "The thin square honey-wood seat, clipped/softened corners, three boards, splayed supports and stretcher remain identifiable at intended size.",
      "Seat rim and support edges have gentle readable volume rather than abrupt faceted bands; softening stays within the source envelope and seat height."
    ],
    "color": [
      "Maintain honey-yellow/golden-orange seat and warm brown legs/stretcher.",
      "Seat retains tonal room for highlights, midtones and edge shading without flattening to one bright yellow patch; lower supports retain brown/orange information rather than becoming black or gray."
    ],
    "lightingHighlights": [
      "Broad subdued highlights and gradual transitions convey warm matte/satin cartoon wood.",
      "Equivalent sides have coherent light treatment across N/E/S/W; no unilateral shiny stripe, bright burned outline or directional ground shadow.",
      "Underside/joins can be darker but remain legible without large dead-black regions."
    ],
    "materialDetail": [
      "Two board seams read as gentle inset separations rather than harsh painted stripes or deep black slits.",
      "Any grain or color variation is restrained and follows the wood surface; no noisy texture or uniform plastic glare is required.",
      "Leg/stretcher joins remain clean and distinct; smooth surface shading does not smear the structure."
    ],
    "artifactFreeReadability": [
      "All four facings are clean at logical use size and enlarged: no halos, isolated pixels, alpha fringes, broken corners, seams, coplanar overlap artifacts, clipped edges or floating supports.",
      "Four-view sheet and repeated preview use identical scale/registration and show a coherent stool without per-view fitting.",
      "Seat and supports remain distinct on neutral light, gray and dark backgrounds; soft lighting must not erase the board layout or merge the legs."
    ]
  },
