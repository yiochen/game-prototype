extends SceneTree
const Overlay = preload("res://scripts/performance_overlay.gd")

func _initialize() -> void:
	var overlay := Overlay.new()
	overlay.record_frame(1000000)
	for i in range(1, 61): overlay.record_frame(1000000 + i * 16667)
	assert(absf(overlay.statistics().fps - 60.0) < 0.1)
	overlay.record_frame(2100020)
	assert(overlay.statistics().worst_ms > 99.9)
	assert(overlay.statistics().fps < 60.0)
	for i in range(1, 71): overlay.record_frame(2100020 + i * 16667)
	assert(overlay.statistics().worst_ms < 17.0, "Old hitch must age out")
	overlay._notification(Node.NOTIFICATION_APPLICATION_PAUSED)
	assert(overlay.samples.is_empty())
	overlay._notification(Node.NOTIFICATION_APPLICATION_RESUMED)
	overlay.record_frame(9000000)
	assert(overlay.statistics().worst_ms == 0.0, "Suspend must not count as a hitch")
	overlay.reset_samples()
	overlay.record_frame(1000000)
	overlay.record_frame(1016667, 5000)
	overlay.record_frame(1033334, 15000)
	assert(is_equal_approx(overlay.statistics().cpu_ms, 10.0), "CPU display must average samples rather than report the latest spike")
	overlay.free()
	print("Performance overlay cadence/hitch/resume checks passed")
	quit()
